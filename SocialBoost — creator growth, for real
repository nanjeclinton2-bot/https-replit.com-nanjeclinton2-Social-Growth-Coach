.sb-text-button { padding: 0px 12px; border: 1px solid transparent; color: rgb(170, 182, 177); background: transparent; }

.sb-text-button:hover { color: var(--sb-ink); background: rgba(255, 255, 255, 0.04); }

.sb-primary-button { padding: 0px 15px; border: 1px solid rgb(131, 208, 179); color: rgb(16, 32, 28); background: rgb(145, 223, 193); box-shadow: rgba(74, 169, 128, 0.13) 0px 5px 16px; }

.sb-primary-button:hover { background: rgb(165, 235, 207); transform: translateY(-1px); }

.sb-primary-button:focus-visible, .sb-text-button:focus-visible, .sb-purchase-close:focus-visible, .sb-funds-alert a:focus-visible { outline: rgb(177, 240, 213) solid 2px; outline-offset: 3px; }

.sb-inline-error { display: flex; align-items: center; gap: 7px; margin: 11px 0px 0px; color: rgb(241, 180, 167); font-size: 10px; line-height: 1.45; }

.sb-inline-error svg { flex: 0 0 auto; }

.sb-review-body { padding-top: 0px; }

.sb-review-service { padding: 15px; border: 1px solid rgb(52, 69, 65); border-radius: 14px; background: rgba(27, 42, 38, 0.55); }

.sb-review-label { margin-bottom: 8px; color: rgb(148, 164, 156); font: 8px var(--app-font-mono, monospace); letter-spacing: 0.1em; text-transform: uppercase; }

.sb-review-title { color: var(--sb-ink); font: 650 13px/1.45 var(--app-font-display, sans-serif); }

.sb-review-title small { display: block; margin-top: 4px; color: rgb(158, 174, 166); font: 9px var(--app-font-mono, monospace); }

.sb-review-service > p { margin-top: 9px; }

.sb-review-details { margin-top: 18px; padding: 0px 2px; }

.sb-review-row { display: grid; grid-template-columns: minmax(100px, 0.7fr) 1.3fr; gap: 12px; padding: 10px 0px; border-top: 1px solid rgba(139, 160, 151, 0.12); }

.sb-review-row > span { color: var(--sb-muted); font-size: 9px; }

.sb-review-row > strong { overflow-wrap: anywhere; color: rgb(220, 230, 224); font-size: 10px; font-weight: 550; line-height: 1.5; white-space: pre-wrap; }

.sb-balance-panel { margin-top: 12px; padding: 14px 15px; border: 1px solid rgb(53, 66, 63); border-radius: 14px; background: rgba(10, 17, 19, 0.44); }

.sb-balance-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: rgb(168, 181, 175); font-size: 9px; }

.sb-balance-row strong { color: rgb(215, 224, 219); font: 11px var(--app-font-mono, monospace); white-space: nowrap; }

.sb-cost-row { margin-top: 11px; }

.sb-cost-row strong { color: var(--sb-lilac); }

.sb-balance-divider { height: 1px; margin: 12px 0px; background: rgba(139, 160, 151, 0.17); }

.sb-after-row { align-items: flex-start; }

.sb-after-row > span { display: grid; gap: 4px; }

.sb-after-row small { color: rgb(120, 137, 130); font-size: 8px; }

.sb-after-row strong { color: var(--sb-mint); font-size: 13px; }

.sb-funds-alert { display: flex; align-items: flex-start; gap: 10px; margin-top: 12px; padding: 12px; border: 1px solid rgb(118, 84, 66); border-radius: 12px; color: rgb(240, 200, 169); background: rgba(86, 50, 35, 0.28); }

.sb-funds-alert > svg { flex: 0 0 auto; color: rgb(229, 170, 121); }

.sb-funds-alert strong { display: block; margin-bottom: 4px; color: rgb(242, 214, 189); font-size: 10px; }

.sb-funds-alert p { margin: 0px; color: rgb(210, 179, 156); font-size: 9px; line-height: 1.5; }

.sb-funds-alert a { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; color: rgb(168, 228, 202); font-size: 9px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

.sb-review-actions { margin-top: 16px; }

@keyframes sb-purchase-fade { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes sb-purchase-rise { 
  0% { opacity: 0; transform: translateY(9px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (max-width: 600px) {
  .sb-purchase-backdrop { display: flex; align-items: flex-end; padding: 0px; }
  .sb-purchase-dialog { width: 100%; max-height: min(94dvh, 900px); border-radius: 22px 22px 0px 0px; border-bottom: 0px; padding-bottom: env(safe-area-inset-bottom); animation-name: sb-purchase-sheet; }
  .sb-purchase-header { padding: 19px 19px 0px; }
  .sb-purchase-close { top: 16px; right: 17px; width: 40px; height: 40px; }
  .sb-purchase-heading { padding: 20px 0px 15px; }
  .sb-purchase-body { padding: 0px 19px 18px; }
  .sb-review-body { padding-top: 0px; }
  .sb-primary-button { min-height: 46px; }
  .sb-text-button { min-height: 46px; }
}

@media (max-width: 360px) {
  .sb-purchase-header { padding-right: 15px; padding-left: 15px; }
  .sb-purchase-body { padding-right: 15px; padding-left: 15px; }
  .sb-review-row { grid-template-columns: 1fr; gap: 4px; }
  .sb-purchase-actions { gap: 6px; }
  .sb-primary-button { padding: 0px 10px; font-size: 9px; }
}

@keyframes sb-purchase-sheet { 
  0% { opacity: 0; transform: translateY(18px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (prefers-reduced-motion: reduce) {
  .sb-purchase-backdrop, .sb-purchase-dialog { animation-duration: 0.01ms; }
  .sb-purchase-close, .sb-field input, .sb-field textarea, .sb-primary-button { transition-duration: 0.01ms; }
}
